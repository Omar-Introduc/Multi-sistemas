{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_POSTGRESQL",
      "label": "PostgreSQL",
      "description": "",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    },
    {
      "name": "DS_MYSQL",
      "label": "MySQL",
      "description": "",
      "type": "datasource",
      "pluginId": "mysql",
      "pluginName": "MySQL"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "8.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "piechart",
      "name": "Pie Chart",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Mensajes RENIEC Procesados",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "reniec_messages_processed_total"
        }
      ]
    },
    {
      "title": "Mensajes RENIEC Fallidos",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "reniec_messages_failed_total"
        }
      ]
    },
    {
      "title": "Estado de Préstamos",
      "type": "piechart",
      "datasource": "${DS_POSTGRESQL}",
      "gridPos": { "h": 16, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "rawSql": "SELECT estado, COUNT(*) FROM prestamos GROUP BY estado",
          "format": "table"
        }
      ]
    },
    {
      "title": "Cuentas de Clientes",
      "type": "table",
      "datasource": "${DS_POSTGRESQL}",
      "gridPos": { "h": 16, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [
        {
          "rawSql": "SELECT id_cliente, saldo, tipo_cuenta, estado FROM cuentas ORDER BY saldo DESC LIMIT 10",
          "format": "table"
        }
      ]
    },
    {
      "title": "Conteo de RENIEC",
      "type": "stat",
      "datasource": "${DS_MYSQL}",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "id": 5,
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) FROM personas",
          "format": "table"
        }
      ]
    },
    {
      "title": "JVM Memory Used",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "id": 6,
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{service=\"servicio-banco-lp1\"}"
        }
      ]
    }
  ],
  "schemaVersion": 30,
  "style": "dark",
  "tags": [],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Shibasito Dashboard",
  "uid": "shibasito-dashboard",
  "version": 1
}
