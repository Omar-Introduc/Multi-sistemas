# ===============================================================================
# CONFIGURACIÓN DEL SISTEMA DE VALIDACIÓN
# ===============================================================================
# Este archivo contiene la configuración global para todos los scripts
# de validación del sistema. Copia este archivo a 'config.env' y
# modifica los valores según tu entorno.
# ===============================================================================

# ===============================================================================
# CONFIGURACIÓN DE SERVICIOS
# ===============================================================================

# LP1 Servicio Banco
export LP1_BANCO_URL="http://localhost:8080"
export LP1_BANCO_HEALTH_URL="http://localhost:8080/health"
export LP1_BANCO_API_URL="http://localhost:8080/api"

# LP2 Servicio RENIEC
export LP2_RENIEC_URL="http://localhost:8000"
export LP2_RENIEC_HEALTH_URL="http://localhost:8000/health"
export LP2_RENIEC_API_URL="http://localhost:8000/api"

# RabbitMQ
export RABBITMQ_URL="http://localhost:15672"
export RABBITMQ_MGMT_URL="http://localhost:15672/api"
export RABBITMQ_HOST="localhost"
export RABBITMQ_PORT="5672"
export RABBITMQ_USER="admin"
export RABBITMQ_PASS="admin"

# Redis
export REDIS_URL="redis://localhost:6379"
export REDIS_HOST="localhost"
export REDIS_PORT="6379"

# PostgreSQL (Banco)
export POSTGRES_URL="postgresql://postgres:password@localhost:5432"
export POSTGRES_HOST="localhost"
export POSTGRES_PORT="5432"
export POSTGRES_USER="postgres"
export POSTGRES_PASSWORD="password"
export POSTGRES_DB="banco_lp1"

# MySQL (RENIEC)
export MYSQL_URL="mysql://root:password@localhost:3306"
export MYSQL_HOST="localhost"
export MYSQL_PORT="3306"
export MYSQL_USER="root"
export MYSQL_PASSWORD="password"
export MYSQL_DB="reniec_lp2"

# ===============================================================================
# CONFIGURACIÓN DE TIMEOUTS Y LÍMITES
# ===============================================================================

# Timeouts generales (en segundos)
export DEFAULT_TIMEOUT=30
export BENCHMARK_DURATION=60
export RECOVERY_TIMEOUT=300
export VALIDATION_TIMEOUT=120
export COMMUNICATION_TIMEOUT=45

# Límites de reintentos
export MAX_RETRIES=3
export RETRY_DELAY=5

# Configuración de carga
export CONCURRENT_USERS=10
export TOTAL_REQUESTS=1000
export RAMP_UP_TIME=10
export COOLDOWN_TIME=5

# ===============================================================================
# CONFIGURACIÓN DE UMBRALES CRÍTICOS
# ===============================================================================

# Uso de recursos del sistema
export CPU_THRESHOLD=80          # Porcentaje de CPU
export MEMORY_THRESHOLD=85       # Porcentaje de memoria
export DISK_THRESHOLD=90         # Porcentaje de disco
export LOAD_THRESHOLD=2.0        # Load average

# Tiempo de respuesta (en milisegundos)
export RESPONSE_TIME_THRESHOLD=2000
export CRITICAL_RESPONSE_TIME=5000

# Tasas de error
export ERROR_RATE_THRESHOLD=5    # Porcentaje
export CRITICAL_ERROR_RATE=10

# ===============================================================================
# CONFIGURACIÓN DE ALERTAS
# ===============================================================================

# Configuración de notificaciones
export ENABLE_ALERTS=true
export ALERT_COOLDOWN=300       # Segundos entre alertas del mismo tipo

# Alertas por email
export SMTP_SERVER="smtp.empresa.com"
export SMTP_PORT=587
export SMTP_USER="alerts@empresa.com"
export SMTP_PASSWORD="password"
export ALERT_EMAIL_FROM="sistema@empresa.com"
export ALERT_EMAIL_TO="admin@empresa.com,devops@empresa.com"

# Webhook de Slack
export SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
export SLACK_CHANNEL="#alerts"
export SLACK_USERNAME="Sistema de Validación"

# Webhook de Discord
export DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Telegram Bot
export TELEGRAM_BOT_TOKEN="123456789:ABC..."
export TELEGRAM_CHAT_ID="123456789"

# PagerDuty
export PAGERDUTY_API_KEY="your-api-key"
export PAGERDUTY_SERVICE_KEY="your-service-key"

# ===============================================================================
# CONFIGURACIÓN DE LOGGING
# ===============================================================================

# Configuración de logs
export LOG_LEVEL="INFO"          # DEBUG, INFO, WARN, ERROR
export LOG_RETENTION_DAYS=30     # Días para mantener logs
export ENABLE_JSON_LOGGING=false # Usar formato JSON en logs

# Rutas de directorios
export LOG_DIR="${SCRIPT_DIR}/logs"
export REPORT_DIR="${SCRIPT_DIR}/reports"
export MONITOR_DIR="${SCRIPT_DIR}/monitoring"
export STATE_FILE="${MONITOR_DIR}/state.json"

# ===============================================================================
# CONFIGURACIÓN DE MONITOREO CONTINUO
# ===============================================================================

# Intervalos de verificación (en segundos)
export CHECK_INTERVAL=30         # Verificación de servicios
export METRIC_COLLECTION_INTERVAL=60  # Recolección de métricas
export REPORT_INTERVAL=3600      # Generación de reportes

# Umbrales para alertas de monitoreo continuo
export ALERT_THRESHOLD=3         # Fallos consecutivos antes de alertar
export RECOVERY_THRESHOLD=2      # Éxitos consecutivos para recovery
export DEGRADED_THRESHOLD=5      # Fallos para marcar como degradado

# Configuración de health checks
export HEALTH_CHECK_TIMEOUT=10
export HEALTH_CHECK_RETRIES=3
export HEALTH_CHECK_INTERVAL=300

# ===============================================================================
# CONFIGURACIÓN DE BASES DE DATOS PARA BENCHMARKS
# ===============================================================================

# PostgreSQL Benchmarks
export PGBENCH_SCALE=1           # Escala para pgbench
export PGBENCH_CLIENTS=5         # Clientes para pgbench
export PGBENCH_TIME=30           # Tiempo para pgbench

# Redis Benchmarks
export REDIS_BENCH_REQUESTS=10000
export REDIS_BENCH_CONCURRENT=10

# ===============================================================================
# CONFIGURACIÓN DE ENTORNO
# ===============================================================================

# Zona horaria
export TZ="America/Lima"

# Idioma y locale
export LANG="es_ES.UTF-8"
export LC_ALL="es_ES.UTF-8"

# Variables de entorno adicionales
export PATH="/usr/local/bin:/usr/bin:/bin:$PATH"
export PYTHONPATH="/opt/scripts:$PYTHONPATH"
export JAVA_HOME="/usr/lib/jvm/java-11-openjdk"

# ===============================================================================
# CONFIGURACIÓN DE DOCKER
# ===============================================================================

# Configuración de Docker
export DOCKER_SOCKET="/var/run/docker.sock"
export COMPOSE_PROJECT_NAME="sistema-distribuido"

# Configuración de contenedores específicos
export LP1_CONTAINER_NAME="lp1-servicio-banco"
export LP2_CONTAINER_NAME="lp2-reniec-service"
export RABBITMQ_CONTAINER_NAME="rabbitmq"
export REDIS_CONTAINER_NAME="redis"
export POSTGRES_CONTAINER_NAME="postgres-lp1"
export MYSQL_CONTAINER_NAME="mysql-lp2"

# ===============================================================================
# CONFIGURACIÓN DE SEGURIDAD
# ===============================================================================

# Configuración de seguridad para testing destructivo
export ENABLE_DESTRUCTIVE_TESTS=false
export ENABLE_NETWORK_PARTITION_TESTS=false
export ENABLE_STRESS_TESTS=false

# Configuración de aislamiento
export TEST_NETWORK_NAME="validation-test-network"
export ISOLATION_MODE="docker"

# ===============================================================================
# CONFIGURACIÓN DE REPORTES
# ===============================================================================

# Configuración de reportes HTML
export REPORT_TITLE="Reporte del Sistema"
export REPORT_VERSION="1.0"
export ENABLE_HTML_REPORTS=true
export ENABLE_JSON_REPORTS=true
export ENABLE_CSV_REPORTS=true

# Configuración de gráficos y visualizaciones
export ENABLE_PERFORMANCE_CHARTS=true
export CHART_WIDTH=800
export CHART_HEIGHT=400

# ===============================================================================
# CONFIGURACIÓN DE INTEGRACIONES EXTERNAS
# ===============================================================================

# Prometheus (métricas)
export PROMETHEUS_URL="http://localhost:9090"
export PROMETHEUS_RETENTION="15d"

# Grafana (dashboards)
export GRAFANA_URL="http://localhost:3000"
export GRAFANA_USER="admin"
export GRAFANA_PASSWORD="admin"

# ELK Stack (logs)
export ELASTICSEARCH_URL="http://localhost:9200"
export KIBANA_URL="http://localhost:5601"

# Jaeger (tracing)
export JAEGER_URL="http://localhost:14268"

# ===============================================================================
# CONFIGURACIÓN DE DESARROLLO Y DEBUGGING
# ===============================================================================

# Configuración de debugging
export DEBUG_MODE=false
export VERBOSE_OUTPUT=false
export DRY_RUN=false

# Configuración de testing
export PARALLEL_EXECUTION=false
export FAIL_FAST=true
export CONTINUE_ON_ERROR=false

# Configuración de CI/CD
export CI_MODE=false
export ARTIFACT_RETENTION_DAYS=7
export GENERATE_JUNIT_REPORTS=false

# ===============================================================================
# CONFIGURACIÓN AVANZADA
# ===============================================================================

# Configuración de métricas personalizadas
export CUSTOM_METRICS_ENABLED=false
export METRICS_ENDPOINT="/metrics"
export METRICS_FORMAT="prometheus"

# Configuración de feature flags
export ENABLE_NEW_VALIDATION_FEATURES=false
export ENABLE_EXPERIMENTAL_TESTS=false
export ENABLE_BETA_FEATURES=false

# Configuración de plugins
export ENABLE_PLUGINS=false
export PLUGIN_DIR="${SCRIPT_DIR}/plugins"
export PLUGIN_CONFIG_FILE="${SCRIPT_DIR}/plugins.conf"

# ===============================================================================
# CONFIGURACIÓN DE BACKUP Y RECOVERY
# ===============================================================================

# Configuración de backups automáticos
export ENABLE_AUTOMATIC_BACKUPS=false
export BACKUP_RETENTION_DAYS=7
export BACKUP_SCHEDULE="0 2 * * *"

# Configuración de disaster recovery
export DR_ENABLED=false
export DR_BACKUP_LOCATION="s3://backups-sistema/"
export DR_RESTORE_TIMEOUT=3600

# ===============================================================================
# FIN DE CONFIGURACIÓN
# ===============================================================================

# Verificación de que el archivo fue cargado correctamente
if [[ -n "${SCRIPT_DIR:-}" ]]; then
    echo "✅ Configuración cargada desde config.env"
    echo "📁 Script directory: $SCRIPT_DIR"
    echo "📊 Log directory: ${LOG_DIR:-not set}"
    echo "📋 Report directory: ${REPORT_DIR:-not set}"
else
    echo "❌ Error: SCRIPT_DIR no está definida"
    echo "📝 Asegúrate de ejecutar 'source config.env' desde el directorio de scripts"
fi