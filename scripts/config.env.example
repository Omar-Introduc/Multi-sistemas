# Configuración de ejemplo para Health Checks
# Copia este archivo como config.env y modifica según tu entorno

# =============================================================================
# RABBITMQ CONFIGURATION
# =============================================================================
export RABBITMQ_USER="admin"
export RABBITMQ_PASSWORD="your_secure_password"
export RABBITMQ_HOST="localhost"
export RABBITMQ_PORT="15672"

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
export REDIS_HOST="localhost"
export REDIS_PORT="6379"
export REDIS_PASSWORD="your_redis_password"

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL
export DB_POSTGRES_HOST="localhost"
export DB_POSTGRES_PORT="5432"
export DB_POSTGRES_USER="app_user"
export DB_POSTGRES_PASSWORD="secure_db_password"
export DB_POSTGRES_DB="application_db"

# PostgreSQL Replica (if exists)
export DB_POSTGRES_REPLICA_HOST="localhost"
export DB_POSTGRES_REPLICA_PORT="5433"
export DB_POSTGRES_REPLICA_USER="app_user"
export DB_POSTGRES_REPLICA_PASSWORD="secure_db_password"
export DB_POSTGRES_REPLICA_DB="application_db"

# MySQL
export DB_MYSQL_HOST="localhost"
export DB_MYSQL_PORT="3306"
export DB_MYSQL_USER="app_user"
export DB_MYSQL_PASSWORD="mysql_password"
export DB_MYSQL_DB="application_db"

# MySQL Replica (if exists)
export DB_MYSQL_REPLICA_HOST="localhost"
export DB_MYSQL_REPLICA_PORT="3307"
export DB_MYSQL_REPLICA_USER="app_user"
export DB_MYSQL_REPLICA_PASSWORD="mysql_password"
export DB_MYSQL_REPLICA_DB="application_db"

# MongoDB
export DB_MONGO_HOST="localhost"
export DB_MONGO_PORT="27017"
export DB_MONGO_USER="app_user"
export DB_MONGO_PASSWORD="mongo_password"
export DB_MONGO_DB="application_db"

# =============================================================================
# NOTIFICATIONS CONFIGURATION
# =============================================================================

# Email Alerts
export ALERT_EMAIL="admin@sistema.local"
export SMTP_SERVER="smtp.gmail.com"
export SMTP_PORT="587"
export SMTP_USER="alerts@sistema.local"
export SMTP_PASSWORD="smtp_password"

# Slack Integration
export SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
export SLACK_CHANNEL="#alerts"

# PagerDuty Integration
export PAGERDUTY_API_KEY="your_pagerduty_integration_key"

# =============================================================================
# CUSTOM THRESHOLDS
# =============================================================================

# System Resource Thresholds
export CPU_THRESHOLD_WARNING="70"
export CPU_THRESHOLD_CRITICAL="85"
export MEMORY_THRESHOLD_WARNING="75"
export MEMORY_THRESHOLD_CRITICAL="90"
export DISK_THRESHOLD_WARNING="80"
export DISK_THRESHOLD_CRITICAL="95"

# Database Thresholds
export DB_CONNECTION_THRESHOLD="80"
export DB_RESPONSE_TIME_THRESHOLD="5"

# Redis Thresholds
export REDIS_MEMORY_THRESHOLD="80"
export REDIS_LATENCY_THRESHOLD="50"

# RabbitMQ Thresholds
export RABBITMQ_QUEUE_SIZE_THRESHOLD="1000"
export RABBITMQ_CONNECTION_THRESHOLD="100"

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Levels: DEBUG, INFO, WARN, ERROR
export LOG_LEVEL="INFO"

# Log Retention (days)
export LOG_RETENTION_DAYS="30"

# Report Retention (days)
export REPORT_RETENTION_DAYS="90"

# =============================================================================
# EXTERNAL INTEGRATIONS
# =============================================================================

# Prometheus Metrics (if using Prometheus monitoring)
export PROMETHEUS_ENABLED="false"
export PROMETHEUS_ENDPOINT="http://localhost:9091"

# Grafana Dashboard
export GRAFANA_URL="http://localhost:3000"
export GRAFANA_API_KEY="your_grafana_api_key"

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# SSL/TLS Settings
export VERIFY_SSL_CERTIFICATES="true"
export SSL_CERT_PATH="/etc/ssl/certs/health-checks.crt"
export SSL_KEY_PATH="/etc/ssl/private/health-checks.key"

# API Authentication
export API_AUTH_ENABLED="true"
export API_AUTH_TOKEN="your_api_auth_token"

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Timeout Settings (seconds)
export HTTP_TIMEOUT="30"
export DB_TIMEOUT="15"
export GENERAL_TIMEOUT="60"

# Retry Settings
export MAX_RETRIES="3"
export RETRY_DELAY="5"

# Concurrency
export MAX_CONCURRENT_CHECKS="5"

# =============================================================================
# BACKUP VERIFICATION
# =============================================================================

# Backup Paths
export POSTGRESQL_BACKUP_PATH="/backups/postgresql"
export MYSQL_BACKUP_PATH="/backups/mysql"
export MONGODB_BACKUP_PATH="/backups/mongodb"
export REDIS_BACKUP_PATH="/backups/redis"

# Backup Verification
export VERIFY_BACKUPS="true"
export BACKUP_MAX_AGE_HOURS="24"

# =============================================================================
# CUSTOM CHECKS
# =============================================================================

# Additional endpoints to monitor
export CUSTOM_ENDPOINTS='[
    {"name": "API Gateway", "url": "http://localhost:8080/health", "method": "GET"},
    {"name": "User Service", "url": "http://localhost:8081/health", "method": "GET"},
    {"name": "Payment Service", "url": "http://localhost:8082/health", "method": "GET"}
]'

# =============================================================================
# ENVIRONMENT SPECIFIC SETTINGS
# =============================================================================

# Set environment (development, staging, production)
export ENVIRONMENT="production"

# Feature Flags
export ENABLE_SLACK_ALERTS="true"
export ENABLE_EMAIL_ALERTS="true"
export ENABLE_DETAILED_REPORTING="true"
export ENABLE_METRICS_EXPORT="false"

# =============================================================================
# LOAD BALANCER CONFIGURATION
# =============================================================================

# If using multiple instances
export INSTANCE_ID="server-01"
export LOAD_BALANCER_ENDPOINT="http://localhost/health"

# Health check aggregation
export AGGREGATE_HEALTH_CHECKS="true"
