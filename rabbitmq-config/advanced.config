%% =============================================================================
%% ADVANCED RABBITMQ CONFIGURATION
%% Configuraciones avanzadas de Erlang y RabbitMQ
%% =============================================================================

[
  %% =============================================================================
  %% CONFIGURACIONES DE MEMORIA
  %% =============================================================================
  {
    rabbit,
    [
      %% Configuración de memoria
      {vm_memory_high_watermark, 0.6},
      {vm_memory_high_watermark_paging_ratio, 0.5},
      
      %% Límites de memoria por proceso
      {memory_monitor_interval, 2500},
      
      %% Configuración de GC
      {
        default_memory_calculations,
        [
          {rss, fun erlang:memory/1},
          {total, fun erlang:memory/1},
          {binary, fun erlang:memory/1},
          {ets, fun erlang:memory/1}
        ]
      }
    ]
  },

  %% =============================================================================
  %% CONFIGURACIONES DE RED Y CONEXIONES
  %% =============================================================================
  {
    rabbit,
    [
      %% Timeouts de conexión
      {handshake_timeout, 30000},
      {connection_timeout, 30000},
      {reverse_dns_lookups, false},
      
      %% Configuración de TCP
      {tcp_listen_options, [
        {backlog, 128},
        {nodelay, true},
        {linger, {true, 0}},
        {exit_on_close, false},
        {keepalive, true}
      ]},
      
      %% Límites de conexiones
      {max_connections, 1000},
      {max_channels_per_connection, 200},
      
      %% Configuración de SSL (deshabilitado por defecto)
      {ssl_listeners, []},
      {ssl_options, []}
    ]
  },

  %% =============================================================================
  %% CONFIGURACIONES DE COLAS
  %% =============================================================================
  {
    rabbit,
    [
      %% Configuración de colas
      {default_queue_type, classic},
      {default_queue_durable, true},
      {default_queue_auto_delete, false},
      {default_queue_exclusive, false},
      
      %% Límites de colas
      {max_queue_size, 0}, %% 0 = sin límite
      {queue_expiration_mode, all_but_mandatory},
      
      %% Configuración de lazy queues
      {queue_lazy_queue_properties, []},
      
      %% Dead letter settings
      {default_dead_letter_exchange, <<"">>},
      {default_dead_letter_routing_key, <<"">>}
    ]
  },

  %% =============================================================================
  %% CONFIGURACIONES DE CLUSTERING
  %% =============================================================================
  {
    rabbit,
    [
      %% Clustering
      {cluster_formation, [
        {peer_discovery_backend, classic_config},
        {classic_config_nodes, ['rabbit@localhost']}
      ]},
      
      %% Configuración de nodes
      {cluster_nodes, {['rabbit@localhost'], disc}},
      
      %% Configuración de cluster state
      {cluster_kept_history_size, 100},
      {cluster_formation_peer_discovery_backend, classic_config}
    ]
  },

  %% =============================================================================
  %% CONFIGURACIONES DE LOGGING
  %% =============================================================================
  {
    rabbit,
    [
      %% Logging
      {log_levels, [
        {connection, error},
        {channel, info},
        {queue, info},
        {mirroring, info}
      ]},
      
      %% Configuración de archivos de log
      {log_file, <<"rabbitmq.log">>},
      {sasl_log_file, <<"rabbitmq-sasl.log">>},
      {log_dir, <<".">>},
      
      %% Console logging
      {log_console, true},
      {log_console_level, info}
    ]
  },

  %% =============================================================================
  %% CONFIGURACIONES DE MONITOREO Y MÉTRICAS
  %% =============================================================================
  {
    rabbit,
    [
      %% Métricas de management
      {management_sample_retention_policies, [
        {global, [{sample_interval, 60}, {retention, 1440}]}, % 1 día
        {global, [{sample_interval, 300}, {retention, 4320}]}, % 30 días
        {rabbitmq_admin, [{sample_interval, 300}, {retention, 4320}]}
      ]},
      
      %% Health checks
      {default_health_check_delay, 60000},
      {cluster_health_check_delay, 20000},
      
      %% Event exchange
      {default_user_pass, <<"admin123_secure_2024">>},
      {enabled_plugins_file, <<"enabled_plugins">>},
      {plugins_dir, <<"plugins">>}
    ]
  },

  %% =============================================================================
  %% CONFIGURACIONES DE SEGURIDAD
  %% =============================================================================
  {
    rabbit,
    [
      %% Autenticación
      {auth_backends, [rabbit_auth_backend_internal]},
      {default_user, <<"admin">>},
      {default_pass, <<"admin123_secure_2024">>},
      {default_permissions, [<<".*">>, <<".*">>, <<".*">>]},
      {default_vhost, <<"/">>},
      
      %% Guest user
      {loopback_users, none},
      
      %% Configuración de credenciales
      {password_hashing_module, rabbit_auth_mechanism_plain_crypto},
      {password_cramming_salt, true},
      
      %% Heartbeat
      {heartbeat, 60},
      
      %% Frame size
      {frame_max, 131072}
    ]
  },

  %% =============================================================================
  %% CONFIGURACIONES DE PERFORMANCE
  %% =============================================================================
  {
    rabbit,
    [
      %% Consumer settings
      {prefetch_count, 10},
      {default_consumer_prefetch, true},
      
      %% Publisher confirms
      {publisher_confirms, true},
      {confirm_select, false},
      
      %% Mandatory delivery
      {mandatory_message_timeout, 30000},
      
      %% Queue master locator
      {default_queue_master_locator, <<"random">>},
      
      %% Flow control
      {flow_control_scale_factor, 2}
    ]
  },

  %% =============================================================================
  %% CONFIGURACIONES DE RATE LIMITING
  %% =============================================================================
  {
    rabbit,
    [
      %% Rate limiting global
      {rate_limiting_v2_global, []},
      
      %% Consumer rate limiting
      {default_consumer_timeout, 30000},
      
      %% Channel flow control
      {channel_flow, true}
    ]
  },

  %% =============================================================================
  %% CONFIGURACIONES DE ERLANG VM
  %% =============================================================================
  {
    erlang,
    [
      %% Configuraciones de la VM de Erlang
      {erts_version, "10.7.2.11"},
      
      %% Aplicaciones OTP
      {start_boot_sections, [
        kernel,
        stdlib,
        sasl
      ]},
      
      %% Configuraciones de memoria
      {process_limit, 1048576},
      {port_limit, 65536},
      
      %% GC settings
      {fullsweep_after, 1000},
      {min_bin_vheap_size, 46422},
      {min_heap_size, 233},
      
      %% Distribution
      {kernel, [
        {inet_dist_listen_min, 9100},
        {inet_dist_listen_max, 9109}
      ]}
    ]
  },

  %% =============================================================================
  %% CONFIGURACIONES DE SASL
  %% =============================================================================
  {
    sasl,
    [
      %% SASL config
      {sasl_error_logger, {file, <<"rabbitmq-sasl.log">>}},
      {errlog_type, error},
      
      %% Mnesia
      {mnesia_dir, <<"mnesia">>},
      {mnesia_dump_log_write_threshold, 100},
      {mnesia_dump_log_time_threshold, 60000}
    ]
  },

  %% =============================================================================
  %% CONFIGURACIONES DE PLUGINS
  %% =============================================================================
  {
    rabbit,
    [
      %% Enabled plugins (will be loaded at startup)
      {plugins_dir, <<"plugins">>},
      
      %% Plugin configuration
      {enabled_plugins, [
        rabbitmq_management,
        rabbitmq_management_agent,
        rabbitmq_management_visualiser,
        rabbitmq_tracing,
        rabbitmq_top
      ]}
    ]
  },

  %% =============================================================================
  %% CONFIGURACIONES DE HAPROXY (para load balancing)
  %% =============================================================================
  {
    rabbit,
    [
      %% Configuraciones para HAProxy
      {haproxy_use_resolved_ips, false},
      {haproxy_pools, []},
      
      %% Health check
      {health_check_timeout, 10000}
    ]
  }
].